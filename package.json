{
  "name": "ting-music",
  "version": "0.9.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "node scripts/tauri.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "check:release": "node scripts/check-release.mjs",
    "format": "prettier --write src tests/*.ts tests/*.mjs playwright.config.ts",
    "format:check": "prettier --check src tests/*.ts tests/*.mjs playwright.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "jsqr": "^1.4.0",
    "lucide": "^0.468.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "pngjs": "^7.0.0",
    "prettier": "3.9.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  },
  "description": "A compact Tauri music player for NetEase Cloud Music and QQ Music"
}
