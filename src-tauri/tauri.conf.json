{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "听 · Ting",
  "version": "0.9.7",
  "identifier": "com.ting.music.demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "听 · Ting",
        "width": 480,
        "height": 720,
        "minWidth": 400,
        "minHeight": 560,
        "backgroundColor": "#F7F8F2",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "trafficLightPosition": {
          "x": 16,
          "y": 28
        },
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,HardwareMediaKeyHandling,MediaSessionService --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.music.126.net https://*.music.163.com https://*.126.net https://*.gtimg.cn https://*.qq.com; media-src 'self' blob: https://*.music.126.net https://*.music.163.com https://*.qq.com; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/build/": "build/",
      "../resources/licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "bundleVersion": "90701"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NjcxNzA3MDlCMjU3QTUKUldTbFY3SUpCeGRuS0tzR1ZtWVZ1SWltTHR1WnFLWTFQdVV0ck41Z1pYQjMrb2ZINVJmb0NQTm8K",
      "endpoints": [
        "https://github.com/idiotFan/ting-music/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
